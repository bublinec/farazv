{
  "name": "farazv-remake",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "content:check": "node --conditions=react-server --import tsx scripts/import-content.ts",
    "content:import": "node --conditions=react-server --import tsx scripts/import-content.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:restore": "node --import tsx scripts/restore.ts",
    "env:check": "node --import tsx scripts/verify-env.ts",
    "test:admin": "node --import tsx scripts/test-admin.ts",
    "test:integration": "node --import tsx scripts/test-integration.ts",
    "media:verify": "node --conditions=react-server --import tsx scripts/verify-cloudinary.ts",
    "test:accessibility": "playwright test tests/browser/accessibility.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "content:generate": "node --conditions=react-server --import tsx scripts/migration/export-information.ts",
    "content:generate:check": "npm run content:generate -- --check"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-underline": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "better-auth": "1.7.14",
    "cheerio": "1.2.0",
    "cloudinary": "2.11.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "maplibre-gl": "6.16.0",
    "marked": "18.1.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/prettier": "2.7.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "2.8.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    }
  }
}
