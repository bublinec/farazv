# PostgreSQL (local PostgreSQL or the pooled Neon URL; never NEXT_PUBLIC_).
DATABASE_URL=

# database for the real app; fixtures is an explicit public design demo only.
CONTENT_SOURCE=database
SITE_URL=https://farazv.sk
# Enable only on the verified production deployment after the launch checks.
SITE_INDEXING_ENABLED=false

# Better Auth: generate a random secret of at least 32 characters privately.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact verified Google addresses, comma separated. Empty denies all access.
ADMIN_EMAIL_ALLOWLIST=

# Existing account; API credentials stay on the server.
CLOUDINARY_CLOUD_NAME=dmx3wfvko
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only for CONTENT_SOURCE=fixtures. Never changes a real production schedule.
PREVIEW_DATE=

# Optional disposable localhost database for the real PostgreSQL test suite.
# The name must start farazv_remake_store_test_; it must not exist already.
TEST_DATABASE_URL=
# Optional localhost maintenance connection for isolated test runners (CREATEDB).
TEST_POSTGRES_URL=
# Prefer a direct connection for backups of a hosted pooled database.
BACKUP_DATABASE_URL=
# Optional client binaries. The hosted Neon server requires PostgreSQL 18 tools.
PG_DUMP_BIN=
PG_RESTORE_BIN=
# Restore target must be separate and empty; never set to DATABASE_URL.
RESTORE_DATABASE_URL=
